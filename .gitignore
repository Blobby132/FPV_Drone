# ---------------------------------------------------------------------------
# Unreal Engine 5 C++ project .gitignore
# ---------------------------------------------------------------------------

# Engine-generated folders (rebuilt on demand)
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Plugins/**/Binaries/
Plugins/**/Intermediate/

# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
*.sln
*.suo
*.sdf
*.opensdf
*.opendb
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.user
*.code-workspace
*.slnx

# Xcode (macOS)
*.xcodeproj
*.xcworkspace

# Compiled / intermediate binaries
*.obj
*.o
*.pdb
*.lib
*.a
*.dll
*.exe
*.app
*.ipa
*.pch
*.gch
*.ilk
*.exp

# Cooked / packaged output
*.pak
*.ucas
*.utoc

# OS cruft
.DS_Store
Thumbs.db
desktop.ini
